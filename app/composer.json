{
  "name": "docker-template/app",
  "type": "project",
  "require": {
        "nikic/fast-route": "^1.3",
        "tecnickcom/tcpdf": "^6.11",
        "phpmailer/phpmailer": "^7.0",
        "stripe/stripe-php": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
