# Copy to ".env" in this folder (next to docker-compose.yml) and fill in values.
# Docker Compose loads this file into the php service.

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=your_db
DB_USERNAME=your_user
DB_PASSWORD=your_password

# Public URL of the site (used in password-reset links in emails)
APP_URL=http://localhost

# --- Email (PHPMailer) ---
# Dev: use Mailtrap SMTP credentials from the Mailtrap inbox UI.
# Prod / real Gmail: use a Gmail app password (2FA required), not your normal password.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Haarlem Festival

# Optional: set to 1 only while debugging mail; turn off in production
# APP_DEBUG=0
